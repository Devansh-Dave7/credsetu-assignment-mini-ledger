{
  "name": "miniledger",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev:api": "npm run dev -w @miniledger/api",
    "dev:mobile": "npm run start -w @miniledger/mobile",
    "android": "npm run android -w @miniledger/mobile",
    "db:generate": "npm run db:generate -w @miniledger/api",
    "db:migrate": "npm run db:migrate -w @miniledger/api",
    "db:test:migrate": "npm run db:test:migrate -w @miniledger/api",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "npm run test --workspaces",
    "build": "npm run build -w @miniledger/api",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.56.0"
  },
  "overrides": {
    "react-dom": "19.3.0",
    "react": "19.3.0"
  }
}
